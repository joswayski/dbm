#!/usr/bin/env bash
#
# Amp orb setup for DBM.
#
# Prepares a fresh orb to build and test the Rust workspace and the native
# egui workbench (apps/native/workbench):
#
#   * the native workbench's Linux build dependencies and redis-server (the
#     live Redis tests skip themselves when redis-server is missing)
#   * the Rust toolchain pinned in rust-toolchain.toml
#   * the locked Cargo dependencies of both Cargo workspaces
#
# Amp runs this before snapshotting a new project orb and again whenever a stale
# snapshot is refreshed, so every step checks first and is safe to repeat.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

cargo_bin="$HOME/.cargo/bin"
rust_toolchain="1.94.0"

log() { printf '\n==> %s\n' "$*"; }

timed() {
  local label="$1"
  shift
  log "$label"
  local started=$SECONDS
  "$@"
  printf '    %s took %ss\n' "$label" "$((SECONDS - started))"
}

install_system_packages() {
  # The Linux dependencies from .github/workflows/ci.yml's Rust and native
  # workbench jobs. Some are already in the orb image but stay listed so this
  # also works on a bare Debian machine.
  local packages=(
    build-essential
    libssl-dev
    pkg-config
    libxkbcommon-dev
    libwayland-dev
    libx11-dev
    libxcursor-dev
    libxi-dev
    libxrandr-dev
    libvulkan1
    mesa-vulkan-drivers
    redis-server
  )
  local missing=()
  local package
  for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
      missing+=("$package")
    fi
  done
  if ((${#missing[@]} == 0)); then
    echo "All system packages are already installed."
    return
  fi
  echo "Installing: ${missing[*]}"
  sudo apt-get update
  sudo apt-get install -y "${missing[@]}"
}

install_rust() {
  if [ ! -x "$cargo_bin/rustup" ]; then
    echo "Installing rustup."
    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs |
      sh -s -- -y --no-modify-path --profile minimal --default-toolchain none
  fi
  # The installer cannot update this running script's environment.
  # shellcheck disable=SC1091
  . "$HOME/.cargo/env"
  if ! rustup toolchain list | grep -q "^${rust_toolchain}"; then
    echo "Installing the Rust ${rust_toolchain} toolchain."
    rustup toolchain install "$rust_toolchain" --profile minimal --no-self-update
  fi
  local installed
  installed="$(rustup component list --toolchain "$rust_toolchain" --installed)"
  if ! printf '%s\n' "$installed" | grep -q '^rustfmt' ||
    ! printf '%s\n' "$installed" | grep -q '^clippy'; then
    echo "Adding the rustfmt and clippy components."
    rustup component add --toolchain "$rust_toolchain" rustfmt clippy
  fi
  rustup default "$rust_toolchain" >/dev/null
  echo "Rust $(rustc --version) is ready."
}

persist_toolchain_path() {
  # Amp starts later commands and supervised services in login shells that do
  # not inherit this script's environment, so persist the toolchain locations.
  local marker="# DBM orb toolchain (added by .agents/setup)"
  local file
  for file in "$HOME/.bash_profile" "$HOME/.bashrc"; do
    [ -f "$file" ] || continue
    if grep -Fqx "$marker" "$file"; then
      continue
    fi
    {
      printf '\n%s\n' "$marker"
      printf '%s\n' 'if [ -f "$HOME/.cargo/env" ]; then . "$HOME/.cargo/env"; fi'
    } >>"$file"
  done
}

fetch_rust_dependencies() {
  cargo fetch --locked
  cargo fetch --locked --manifest-path apps/native/workbench/Cargo.toml
}

timed "Installing system packages" install_system_packages
timed "Installing the Rust toolchain" install_rust
persist_toolchain_path

export PATH="$cargo_bin:$PATH"

timed "Fetching Cargo dependencies" fetch_rust_dependencies

log "Orb setup complete"
rustc --version
cargo --version
