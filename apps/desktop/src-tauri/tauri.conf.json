{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBM",
  "version": "0.1.0",
  "identifier": "io.github.joswayski.dbm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DBM",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["dmg", "nsis", "deb", "appimage"],
    "shortDescription": "A focused, private database manager",
    "longDescription": "DBM is a cross-platform PostgreSQL manager and SQL workbench for personal use.",
    "category": "DeveloperTool"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4QkFEMUU0MTIxREI1NjcKUldSbnRSMFM1Tkc2ZUNGYnNSRVhka2hIUTE3ak1BVVJyZTFxaVBTZ0UrWFk0c2VhVFpiWFdHenUK",
      "endpoints": [
        "https://github.com/joswayski/dbm/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
