{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBV",
  "version": "0.1.0",
  "identifier": "io.github.joswayski.dbv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DBV",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["dmg", "nsis", "deb", "appimage"],
    "shortDescription": "A focused, private database viewer",
    "longDescription": "DBV is a cross-platform PostgreSQL viewer and SQL workbench for personal use.",
    "category": "DeveloperTool"
  }
}
